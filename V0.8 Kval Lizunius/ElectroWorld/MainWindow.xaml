<Window x:Class="ElectroWorld.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ElectroWorld - Магазин" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        MinHeight="500" MinWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Background="#19493f">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1" Text="ElectroWorld" 
                           FontSize="28" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <Button x:Name="btnTheme" Grid.Column="2" 
                        Content="🎨" FontSize="20" Width="50" Height="40"
                        Margin="0,0,20,0" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="White"
                        Click="BtnTheme_Click"/>
            </Grid>
        </Border>

        <!-- ПАНЕЛЬ ПОИСКА -->
        <Border Grid.Row="1" Background="#F0F0F0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" 
                         FontSize="14" Padding="5" Margin="0,0,10,0"/>

                <ComboBox x:Name="cmbSort" Grid.Column="1" Width="180" 
                          Margin="0,0,10,0" FontSize="13" Padding="3">
                    <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                    <ComboBoxItem Content="от 0% до 14.99%"/>
                    <ComboBoxItem Content="от 15% до 24.99%"/>
                    <ComboBoxItem Content="более 25%"/>
                </ComboBox>

                <Button x:Name="btnSearch" Grid.Column="2" 
                        Content="Найти" Width="80" Height="30"
                        Background="#359A85" Foreground="White"
                        FontWeight="Bold" Click="BtnSearch_Click"/>
            </Grid>
        </Border>

        <!-- СПИСОК ТОВАРОВ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="productsList" Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- КАРТОЧКА ТОВАРА (без MouseEnter/MouseLeave) -->
                        <Border Width="320" Height="170" Margin="8" CornerRadius="8" 
                                BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <!-- КАРТИНКА -->
                                <Border Grid.Column="0" Width="70" Height="70" 
                                        Background="#EEEEEE" CornerRadius="5">
                                    <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
                                </Border>

                                <!-- НАЗВАНИЕ И ОПИСАНИЕ -->
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="11" Foreground="Gray"
                                               TextWrapping="Wrap" 
                                               MaxHeight="50"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- ЦЕНА -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:0} ₽}"
                                               FontWeight="Bold" FontSize="16" Foreground="#359A85"/>
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:0} ₽}"
                                               FontSize="10" Foreground="Gray"
                                               TextDecorations="Strikethrough"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- НИЖНЯЯ ПАНЕЛЬ -->
        <Border Grid.Row="3" Background="#F0F0F0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtCounter" Grid.Column="0" 
                           Text="Показано: 0 из 0" 
                           VerticalAlignment="Center" FontSize="13"/>

                <!-- КНОПКА КОРЗИНЫ -->
                <Button x:Name="btnCart" Grid.Column="1" 
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnCart_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛒" FontSize="24" VerticalAlignment="Center"/>
                        <Border x:Name="cartBadge" Background="#fc8181" CornerRadius="12"
                                Width="24" Height="24" Margin="5,0,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="cartCount" Text="0" 
                                       Foreground="White" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>