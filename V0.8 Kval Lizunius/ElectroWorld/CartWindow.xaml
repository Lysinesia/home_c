<Window x:Class="ElectroWorld.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ElectroWorld - Корзина" 
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА (без кнопки темы) -->
        <Border x:Name="CartHeaderBorder" Grid.Row="0" Background="#19493f">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🛍️" FontSize="30" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="КОРЗИНА" 
                           FontSize="24" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <!-- КНОПКИ ТЕМЫ НЕТ! -->
            </Grid>
        </Border>

        <!-- ТАБЛИЦА -->
        <DataGrid x:Name="cartGrid" Grid.Row="1" 
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  Margin="10" IsReadOnly="True"
                  AlternatingRowBackground="#F5F5F5">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Width="200" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Описание" Width="*" Binding="{Binding Description}"/>
                <DataGridTextColumn Header="Количество" Width="80" Binding="{Binding Quantity}"/>
                <DataGridTextColumn Header="Цена" Width="100" Binding="{Binding Price, StringFormat={}{0:0} ₽}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- СУММА -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Общая сумма заказов:" 
                           FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="txtTotal" Grid.Column="1" 
                           Text="0 ₽" FontSize="18" FontWeight="Bold"
                           Foreground="#359A85"/>
            </Grid>
        </Border>

        <!-- НИЖНЯЯ ПАНЕЛЬ -->
        <Border Grid.Row="3" Background="#F0F0F0" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnClear" Grid.Column="0" 
                        Content="🗑️ Очистить корзину" Width="150" Height="35"
                        Background="#fc8181" Foreground="White"
                        Click="BtnClear_Click"/>

                <Button x:Name="btnCheckout" Grid.Column="1" 
                        Content="✅ Оформить заказ" Width="150" Height="35"
                        Background="#359A85" Foreground="White"
                        Margin="10,0,0,0" Click="BtnCheckout_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>