<Window x:Class="Samorukov.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Samorukov - Корзина" 
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                         CornerRadius="8"
                         BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#19493f"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border x:Name="CartHeaderBorder" Grid.Row="0" Background="#19493f" CornerRadius="0,0,15,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Корзина" 
                           FontSize="24" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" HorizontalAlignment="Left" FontFamily="Segoe Print" Width="117" Grid.ColumnSpan="2" Margin="10,0,0,0"/>

            </Grid>
        </Border>

        <DataGrid x:Name="cartGrid" Grid.Row="1"  
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  Margin="10" IsReadOnly="True"
                  AlternatingRowBackground="#F5F5F5" FontFamily="Segoe Print">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Width="200" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Описание" Width="*" Binding="{Binding Description}"/>
                <DataGridTextColumn Header="Количество" Width="80" Binding="{Binding Quantity}"/>
                <DataGridTextColumn Header="Цена" Width="100" Binding="{Binding Price, StringFormat={}{0:0} ₽}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="#F0F0F0" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Общая сумма заказов:" 
                           FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" FontFamily="Segoe Print"/>

                <TextBlock x:Name="txtTotal" Grid.Column="1" 
                           Text="0 ₽" FontSize="18" FontWeight="Bold"
                           Foreground="#19493f"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#F0F0F0" Padding="15" Margin="0,47,0,0" Grid.RowSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnClear" Grid.Column="0"
                        Style="{StaticResource RoundedButtonStyle}"
                        Content="Очистить корзину" Height="35"
                        Foreground="White"
                        Click="BtnClear_Click" FontFamily="Segoe Print" Margin="194,4,291,4"/>

                <Button x:Name="btnCheckout"
                        Style="{StaticResource RoundedButtonStyle}"
                        Content="Оформить заказ" Height="35"
                        Foreground="White"
                        Margin="478,4,10,4" Click="BtnCheckout_Click" FontFamily="Segoe Print"/>
            </Grid>
        </Border>
    </Grid>
</Window>