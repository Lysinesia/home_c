<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Samorukov.MainWindow"
        Title="Samorukov - Магазин" 
        Height="650" Width="1010"
        WindowStartupLocation="CenterScreen"
        MinHeight="450" MinWidth="700">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#19493f"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Border x:Name="HeaderBorder" Grid.Row="0" Background="#19493f"
                CornerRadius="0,0,15,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1" Text=" Магазин &quot;Samorukov&quot;" 
                           FontSize="28" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontFamily="Segoe Print"/>

                <Button x:Name="btnTheme" Grid.Column="2"
                        Style="{StaticResource RoundedButtonStyle}"
                        Content="Сменить тему" FontSize="14" Width="168" Height="40"
                        Margin="0,0,0,40" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="White"
                        Cursor="Hand" Click="BtnTheme_Click" FontFamily="Segoe Print"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#F0F0F0" Padding="10"
                CornerRadius="10" Margin="10,10,10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" 
                         FontSize="14" Padding="8" Margin="0,0,100,0"
                         FontFamily="Segoe UI"/>

                <ComboBox x:Name="cmbSort" Width="180" 
                          Margin="632,0,68,0" FontSize="13" Padding="5" FontFamily="Segoe Print" Grid.ColumnSpan="2">
                    <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                    <ComboBoxItem Content="от 0% до 14.99%"/>
                    <ComboBoxItem Content="от 15% до 24.99%"/>
                    <ComboBoxItem Content="более 25%"/>
                </ComboBox>

                <Button x:Name="btnSearch" Grid.Column="2"
                        Style="{StaticResource RoundedButtonStyle}"
                        Content="Найти" Width="90" Height="35"
                        Background="#19493f" Foreground="White"
                        FontWeight="Bold" FontSize="14"
                        Cursor="Hand" Click="BtnSearch_Click" FontFamily="Segoe Print"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="productsList" Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300" Height="160" Margin="8" 
                                CornerRadius="15" 
                                BorderBrush="#19493f" BorderThickness="1.5" 
                                Background="White">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="60" Height="60" 
                                        Background="#EEEEEE" CornerRadius="10">
                                    <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="{Binding Name}" 
                                               FontWeight="Bold" FontSize="14"
                                               TextWrapping="Wrap"
                                               FontFamily="Segoe UI"/>
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="11" Foreground="Gray"
                                               TextWrapping="Wrap" 
                                               MaxHeight="50"
                                               Margin="0,4,0,0"
                                               FontFamily="Segoe UI"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding FinalPrice, StringFormat=\{0:0\} ₽}"
                                               FontWeight="Bold" FontSize="15" 
                                               Foreground="#19493f"
                                               FontFamily="Segoe UI"/>
                                    <TextBlock Text="{Binding Price, StringFormat=\{0:0\} ₽}"
                                               FontSize="10" Foreground="Gray"
                                               TextDecorations="Strikethrough"
                                               Margin="0,2,0,0"
                                               FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F0F0F0" Padding="10"
                CornerRadius="10" Margin="10,398,10,10" Grid.RowSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtCounter" Grid.Column="0" Foreground="#19493f"
                           Text="Показано: 0 из 0" 
                           VerticalAlignment="Center" FontSize="13"
                           FontFamily="Segoe Print" FontWeight="Medium" Grid.ColumnSpan="2" Margin="0,0,642,0"/>
                <Button x:Name="btnCart" Grid.Column="1"
                        Style="{StaticResource RoundedButtonStyle}"
                        Foreground="White"
                        Cursor="Hand" Click="BtnCart_Click" FontFamily="Segoe Print" Margin="756,0,10,0" Height="34" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Корзина" FontSize="14" VerticalAlignment="Center" Width="72"/>
                        <Border x:Name="cartBadge" Background="#fc8181" CornerRadius="12"
                                Width="24" Height="24" Margin="5,0,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="cartCount" Text="0" 
                                        Foreground="White" FontSize="11" FontWeight="Bold"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>