<Window x:Class="TechStoreApp.Views.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корзина - TechStore" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        MinWidth="600" MinHeight="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Шапка -->
            <RowDefinition Height="*"/>
            <!-- Таблица -->
            <RowDefinition Height="50"/>
            <!-- Сумма -->
            <RowDefinition Height="50"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Grid.Row="0" Background="#19493f">
            <Grid>
                <!-- Логотип слева -->
                <TextBlock Text="TechStore" FontSize="20" FontWeight="Bold" 
                           Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>

                <!-- Надпись "Корзина" по центру -->
                <TextBlock Text="КОРЗИНА" FontSize="20" FontWeight="Bold" 
                           Foreground="White" HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>

                <!-- Кнопка смены темы справа -->
                <Button x:Name="btnTheme" Content="🎨" Width="40" Height="35"
        HorizontalAlignment="Right" VerticalAlignment="Center" 
        Margin="0,0,20,0" Background="#359A85" Foreground="White"
        Click="btnTheme_Click"/>
            </Grid>
        </Border>

        <!-- ТАБЛИЦА ТОВАРОВ -->
        <DataGrid x:Name="dgCart" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column"
                  Margin="10" AlternatingRowBackground="#F5F5F5"
                  RowHeight="40">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" 
                                    Width="2*" FontSize="14"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" 
                                    Width="3*" FontSize="12"/>
                <DataGridTextColumn Header="Стоимость" Binding="{Binding Price}" 
                                    Width="1*" FontSize="14"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- СТРОКА С СУММОЙ -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDD" 
                BorderThickness="0,1,0,1">
            <Grid>
                <TextBlock Text="Общая сумма заказов:" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBlock x:Name="txtTotal" Text="0 ₽" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
                           Foreground="#359A85"/>
            </Grid>
        </Border>

        <!-- НИЖНИЕ КНОПКИ -->
        <Border Grid.Row="3" Background="#19493f">
            <Grid>
                <Button x:Name="btnClearCart" Content="🗑 Очистить корзину" 
                        Width="150" Height="35" HorizontalAlignment="Left" Margin="20,0,0,0"
                        Background="#fc8181" Foreground="White" Click="btnClearCart_Click"/>

                <Button x:Name="btnCheckout" Content="✅ Оформить заказ" 
                        Width="150" Height="35" HorizontalAlignment="Right" Margin="0,0,20,0"
                        Background="#359A85" Foreground="White" Click="btnCheckout_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
