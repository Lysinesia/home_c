<Window x:Class="TechStoreApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TechStore - Магазин электроники" 
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        MinWidth="700" MinHeight="500">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <!-- Шапка -->
            <RowDefinition Height="60"/>
            <!-- Поиск -->
            <RowDefinition Height="*"/>
            <!-- Товары -->
            <RowDefinition Height="50"/>
            <!-- Нижняя панель -->
        </Grid.RowDefinitions>

        <!-- ===== ШАПКА (ряд 0) ===== -->
        <Border Grid.Row="0" Background="#19493f">
            <Grid>
                <!-- Логотип по центру -->
                <TextBlock Text="TechStore" FontSize="24" FontWeight="Bold" 
                           Foreground="White" HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>

                <!-- Кнопка смены темы справа -->
                <Button x:Name="btnTheme" Content="🎨" Width="40" Height="35"
        HorizontalAlignment="Right" VerticalAlignment="Center" 
        Margin="0,0,20,0" Background="#359A85" Foreground="White"
        Click="btnTheme_Click"/>
            </Grid>
        </Border>

        <!-- ===== ПАНЕЛЬ ПОИСКА (ряд 1) ===== -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" FontSize="14" 
                         Height="35" VerticalContentAlignment="Center"/>

                <ComboBox x:Name="cmbSort" Grid.Column="1" Width="180" 
                          Height="35" Margin="0,0,10,0" FontSize="13" 
                          SelectedIndex="0">
                    <ComboBoxItem Content="Без сортировки"/>
                    <ComboBoxItem Content="от 0% до 14.99%"/>
                    <ComboBoxItem Content="от 15% до 24.99%"/>
                    <ComboBoxItem Content="более 25%"/>
                </ComboBox>

                <Button x:Name="btnSearch" Grid.Column="2" Content="🔍 Найти" 
                        Width="100" Height="35" Background="#359A85" 
                        Foreground="White" Click="btnSearch_Click"/>
            </Grid>
        </Border>

        <!-- ===== СПИСОК ТОВАРОВ (ряд 2) ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="productsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===== НИЖНЯЯ ПАНЕЛЬ (ряд 3) ===== -->
        <Border Grid.Row="3" Background="#19493f">
            <Grid>
                <!-- Счетчик СЛЕВА (по варианту 1) -->
                <TextBlock x:Name="txtCounter" Text="Показано: 0 из 0" 
                           HorizontalAlignment="Left" VerticalAlignment="Center" 
                           Margin="20,0,0,0" Foreground="White" FontSize="14"/>

                <!-- Кнопка корзины СПРАВА с счетчиком -->
                <Button x:Name="btnCart" Content="🛒 Корзина (0)" 
        Width="150" Height="35" HorizontalAlignment="Right" 
        Margin="0,0,20,0" Background="#359A85" 
        Foreground="White" Click="btnCart_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
